APP_NAME="ProjectSense AI"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY="your-super-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./projectsense.db"
# Example PostgreSQL for Render:
# DATABASE_URL="postgresql+asyncpg://user:password@hostname:5432/dbname"

# =======================
# Frontend / CORS
# =======================
# Add your deployed frontend URL here for production. Use a JSON array string
# (example: ["https://example.vercel.app"]). If using Render, ensure the
# env value is not an empty string — unset it to use defaults instead.
CORS_ORIGINS=["http://localhost:3000", "https://ai-power-academic-project-evaluatio.vercel.app"]

# =======================
# AI Configuration (xAI / Grok)
# =======================
GROK_API_KEY="your-grok-api-key-here"
GROK_MODEL="grok-3"

# =======================
# File Storage & Security
# =======================
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50
